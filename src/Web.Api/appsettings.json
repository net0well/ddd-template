{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7
  },
  "PasswordHasher": {
    "Iterations": 210000
  },
  "Outbox": {
    "Enabled": true,
    "PollingIntervalInMilliseconds": 1000,
    "BatchSize": 50,
    "MaxAttempts": 5,
    "RetentionInDays": 7
  },
  "Jobs": {
    "Schema": "hangfire",
    "Server": {
      "Enabled": true,
      "WorkerCount": 5,
      "QueuePollIntervalInSeconds": 15
    },
    "Dashboard": {
      "Enabled": true,
      "Path": "/hangfire",
      "Username": "",
      "Password": ""
    }
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowInSeconds": 60
    },
    "Authentication": {
      "PermitLimit": 10,
      "WindowInSeconds": 60
    }
  }
}
