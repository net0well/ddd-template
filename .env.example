# Copy to .env (never committed) and change the values.

# Grafana (http://localhost:3000) requires this login.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Only for docker-compose.https.yml: password of the exported dev certificate and, optionally, its folder.
DEV_CERT_PASSWORD=
# DEV_CERT_DIR=~/.aspnet/https
